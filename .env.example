# GEMINI_API_KEY: Google Gemini Yapay Zekâ API Anahtarı
# Google AI Studio'dan (https://aistudio.google.com/app/apikey) ücretsiz alabilirsiniz.
#
# 1. Local Geliştirme İçin:
#    Bu dosyayı kopyalayıp '.env' veya '.env.local' adında kaydedin:
#    GEMINI_API_KEY="AIzaSy..."
#
# 2. Vercel'de Yayınlamak İçin:
#    Vercel Dashboard > Projeniz > Settings > Environment Variables bölümüne gidin:
#    Key: GEMINI_API_KEY
#    Value: Sizin Google Gemini API Anahtarınız
#    Environment: Production, Preview, Development (hepsini seçin)
GEMINI_API_KEY="BURAYA_GEMINI_API_ANAHTARINIZI_YAZIN"

# APP_URL (Opsiyonel): Uygulamanın barındırıldığı alan adı (Örn: https://dolabimda-ne-var.vercel.app)
APP_URL="http://localhost:3000"

# SMTP E-posta Ayarları (Opsiyonel - Günün kombinini e-posta ile göndermek isterseniz):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="sizin-emailiniz@gmail.com"
# SMTP_PASS="uygulama-sifreniz"
